#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase configuration with API keys
/android/app/google-services.json
/lib/firebase_options.dart

# Generated files (build_runner)
*.g.dart
*.freezed.dart
*.gr.dart

# Test artifacts
test/golden/failures/

# Sacred Time city DB build inputs (rebuildable; output is committed under
# assets/data/ and the source URL lives in tool/build_cities_db.dart).
tool/data/cities15000.txt
tool/data/cities15000.zip

# Other
node_modules/

# Go build artifacts (sefaria_fetch)
tool/bin/

# Hebcal fetcher (Node)
tool/hebcal_fetch/node_modules/
tool/hebcal_fetch/package-lock.json

# Sefaria curator artifacts
tool/curate_curricula/__pycache__/

# Build artifacts (regenerate via tool/text_extract — needs Sefaria-Project + Mongo)
tool/data/daily_content_cache.json
tool/text_extract/__pycache__/

# Build artifact (regenerate via tool/text_extract/extract_books.py)
tool/data/book_text_cache.json

# Generated at build time from assets/db/content.db.xz by
# tool/prepare_asset.dart (the .xz is the committed source-of-truth).
assets/db/content.db.gz
