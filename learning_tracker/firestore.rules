rules_version = '2';

// Learning Tracker — Firestore security rules
//
// LIVE LAYOUT (authoritative)
// ────────────────────────────
// users/{uid}                                         — account user-profile doc
// users/{uid}/profile/data                            — account profile snapshot
// users/{uid}/diagnostic_logs/{autoId}                — diagnostic log events
// users/{uid}/learner_profiles/{profileId}            — one doc per learner
// users/{uid}/learner_profiles/{profileId}/<coll>/...
//
// Per-profile subcollections:
//   completions/{completionId}     — append-only; doc-id = structured natural-key
//   streak_events/{ulid}           — append-only streak events (W3.37)
//   learning_ledger/{ulid}         — append-only daily ledger; doc-id = ULID (W3.36)
//   settings/{curriculumId}        — curriculum preference snapshots
//   stage_definitions/{stageId}    — per-track stage config; split from settings (W3.32)
//   curriculum_tracks/{trackId}    — per-curriculum track config snapshots
//   bookmarks/{bookmarkId}         — current bookmark positions
//   learning_order/{orderId}       — learning-order snapshots
//   preferences/{scope}            — unified preference bag (W3.33)
//                                    scopes: notification_settings,
//                                            gamification_settings,
//                                            ui_preferences
//   profile_programs/{curriculumId}— curriculum assignments
//   goals/{goalId}                 — pace goals
//   import_metadata/{curriculumId} — curriculum import metadata (W3.34)
//
// Top-level:
//   tutor_grants/{grantId}         — M:N tutor permission graph (W3.38)
//   tutor_grants/{grantId}/audit_log/{entryId}
//   tutor_active_access/{accessId} — O(1) lookup maintained by Cloud Functions (V2-R3 C2)
//                                    doc-id: {tutorUid}_{parentUid}_{profileId}
//                                    Written by acceptInvite CF; deleted by revoke/resign CFs.
//
// Append-only collections (`completions`, `streak_events`, `learning_ledger`,
// `points_ledger`) deny `delete` and deny value mutation on `update` — only
// an idempotent identical replay (`request.resource.data == resource.data`)
// is allowed, so an outbox retry can re-push the same row without stranding
// it, but a changed value is always rejected (SR-1). Those same 4 collections
// split `read` into `get` (unrestricted) and `list` (capped at
// request.query.limit <= 500, matching the app's kListenerPageSize) so an
// unbounded list can't exfiltrate a child's entire event history in one
// query (SR-4). The 3 event collections that carry a client-supplied
// timestamp (`streak_events.created_at`, `learning_ledger.completed_at`,
// `points_ledger.created_at`) reject any value that isn't a real Firestore
// Timestamp `<= request.time` when the field is present (SR-3), mirroring
// completions' `completed_at` guard. Snapshot collections deny `delete` and
// gate writes through `.hasOnly(...)` field whitelists, plus per-field
// type/size caps on their free-text values (SR-2) where the field set is
// known; open-bag collections (no whitelist by design) get a top-level
// key-count cap instead. All ownership enforced by `isOwner(uid)` on the
// `users/{uid}` path segment.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared helpers ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // True when the caller is the authenticated owner of `uid`.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Tutor grant helpers (W3.41, V2-R3 C2) ────────────────────────────────
    //
    // hasActiveTutorAccess — O(1) lookup via `tutor_active_access` secondary
    // index. Maintained by Cloud Functions: acceptInvite writes the doc,
    // revokeGrant/resignGrant/expirePendingInvites delete it. The doc-id is
    // {tutorUid}_{parentUid}_{profileId} — deterministic from path context so
    // no grantId is needed in the rules. This enables tutor subcollection reads
    // without requiring the client to pass the grantId through the path.

    // V2-R3 C2: O(1) subcollection read check — does not require grantId in
    // the request. Cloud Functions maintain tutor_active_access as a
    // denormalised index of active grants.
    function hasActiveTutorAccess(ownerUid, profileId) {
      let accessId = request.auth.uid + '_' + ownerUid + '_' + profileId;
      return isSignedIn()
          && exists(/databases/$(database)/documents/tutor_active_access/$(accessId));
    }

    // ── Global default-deny ────────────────────────────────────────────────
    // MUST precede every per-collection allow rule so any collection not
    // explicitly listed inherits a hard deny.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── tutor_active_access (top-level) ───────────────────────────────────────
    //
    // Collection: tutor_active_access/{accessId}
    // Doc-id: {tutorUid}_{parentUid}_{profileId}
    //
    // Secondary index maintained by Cloud Functions (Admin SDK).
    // Written by acceptInvite; deleted by revokeGrant/resignGrant/expirePendingInvites.
    // Used by hasActiveTutorAccess() to allow tutor subcollection reads without
    // requiring grantId in the rules context (V2-R3 C2).
    //
    // Clients NEVER write this collection — all mutations are Admin SDK only.
    match /tutor_active_access/{accessId} {
      // Tutors may read their own access entries (accessId starts with their uid).
      allow read: if isSignedIn()
          && resource.data.tutor_uid == request.auth.uid;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ── tutor_grants (top-level) ───────────────────────────────────────────
    //
    // Collection: tutor_grants/{grantId}
    // Doc-id: {encodedEmail}__{parentUid}__{childProfileId}
    //
    // Security posture:
    //   WRITES — ALL mutations go through Cloud Functions (Admin SDK).
    //     - W3.43: bulk-prior proxy writes completions as the owner uid.
    //     - The invite/accept/revoke lifecycle is server-side only.
    //     - Client may NEVER create, update or delete a grant doc.
    //
    //   READS — tutors may read their own active grants; parents may read
    //     grants that reference their uid as parent_uid. Pending grants are
    //     also readable by the tutor (for the accept-invite flow) where the
    //     tutor_email matches (verified by the Cloud Function).
    //
    // Audit log sub-collection:
    //   tutor_grants/{grantId}/audit_log/{entryId}
    //   Written exclusively by Cloud Functions (Admin SDK).
    //   Parents/tutors may read their respective entries.
    match /tutor_grants/{grantId} {
      allow read: if isSignedIn()
          && (
            resource.data.tutor_uid == request.auth.uid
            || resource.data.parent_uid == request.auth.uid
          );

      // ALL writes are server-side (Admin SDK). Clients MUST NOT write
      // grant docs — a malicious client forging state='active' is the
      // primary attack vector.
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      // Audit log — read-only for authorised parties; writes are Cloud
      // Function only. 12-month retention enforced server-side (W3.42).
      match /audit_log/{entryId} {
        allow read: if isSignedIn()
            && (
              get(/databases/$(database)/documents/tutor_grants/$(grantId)).data.parent_uid == request.auth.uid
              || get(/databases/$(database)/documents/tutor_grants/$(grantId)).data.tutor_uid == request.auth.uid
            );
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }
    }

    // ════════════════════════════════════════════════════════════════════════
    // LIVE NESTED LAYOUT — users/{uid}/...
    // This is the layout the application actually reads and writes.
    // ════════════════════════════════════════════════════════════════════════

    match /users/{uid} {

      // Account user-profile document (users/{uid} itself).
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid);
      allow delete: if false;

      // Account profile snapshot — users/{uid}/profile/data
      // OWNER-ONLY: tutor access is intentionally NOT granted here. This is the
      // account-level snapshot, a sibling of learner_profiles/, so it never goes
      // through hasActiveTutorAccess(). Do NOT add a tutor read clause — a tutor
      // must only ever see a learner's per-profile subtree, never account data.
      match /profile/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid);
        allow delete: if false;
      }

      // Diagnostic logs — append-only event stream.
      // OWNER-ONLY: tutor access intentionally excluded (account-scoped, not a
      // learner subtree). Locked by firestore_rules.test.mjs.
      match /diagnostic_logs/{logId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if false;
        allow delete: if false;
      }

      // Learner-profile documents — users/{uid}/learner_profiles/{profileId}.
      // Client deletes are denied — server Cloud Function performs recursive
      // delete via the deleteLearnerProfile callable.
      //
      // TUTOR READ ACCESS (V2-R3 C2): an active tutor may read the learner
      // profile document AND all subcollections via hasActiveTutorAccess().
      // The tutor_active_access secondary index (maintained by Cloud Functions)
      // enables O(1) lookups without requiring the grantId in the path.
      // Tutor WRITE access is intentionally denied on all subcollections except
      // via the tutorBulkPriorCompletions Cloud Function proxy (W3.43).
      match /learner_profiles/{profileId} {
        allow read: if isOwner(uid) || hasActiveTutorAccess(uid, profileId);
        allow create, update: if isOwner(uid);
        allow delete: if false;

        // ── Append-only event collections ──────────────────────────────────

        // completions — one doc per discrete completion act.
        //
        // Doc-id: structured natural key derived from
        //   (profileId, sefariaRef, stageId, trackType, curriculumId) — all
        //   percent-encoded and joined with `_`. This is deterministic and
        //   injective so retries are idempotent (W3.35).
        //
        // `completed_at` MUST be a Firestore Timestamp (not a string) so that
        // `completed_at <= request.time` evaluates correctly.
        //
        // TUTOR WRITE BLOCK (W3.41) — LOAD-BEARING SECURITY BOUNDARY:
        //   `allow create: if isOwner(uid)` means ONLY the profile owner
        //   (request.auth.uid == uid) may write a completion. Tutors have a
        //   different uid, so `isOwner(uid)` is always false for them — even
        //   with an active grant. Tutor bulk-prior completions go through the
        //   Cloud Function proxy (W3.43) which writes as the owner uid via
        //   Admin SDK and enforces the canMarkLiveCompletion=false policy.
        //
        // TUTOR READ (V2-R3 C2): tutors may read completions to view progress.
        match /completions/{completionId} {
          // SR-4: single-doc reads are unrestricted; `list` queries are
          // capped at 500 (the app's kListenerPageSize) so an unbounded
          // list can't exfiltrate a child's entire completion history in
          // one query — get() and list() are split from a single `read`
          // because `request.query.limit` is only meaningful on list().
          allow get: if isOwner(uid) || hasActiveTutorAccess(uid, profileId);
          allow list: if (isOwner(uid) || hasActiveTutorAccess(uid, profileId))
            && request.query.limit <= 500;
          // SECURITY: isOwner(uid) ensures request.auth.uid == uid.
          // A tutor (different uid) is rejected here. This is the primary
          // defence — no tutor can write a live completion from the client.
          allow create: if isOwner(uid)
            && (
              ('points' in request.resource.data)
                ? (request.resource.data.points is number
                    && request.resource.data.points >= 0
                    && request.resource.data.points <= 100)
                : true
            )
            && (
              !('completed_at' in request.resource.data)
                || request.resource.data.completed_at <= request.time
            );
          // SR-1 (append-only): the push uses set(merge:true) on a
          // natural-key doc-id, so an outbox retry after a
          // committed-but-unacked push is an UPDATE — allow ONLY an
          // idempotent identical replay of the existing value, never a
          // changed value (an owner-authenticated client silently
          // overwriting points/completed_at on an existing completion is
          // exactly the record-tampering SR-1 exists to prevent). A tutor
          // (different uid) is still rejected by isOwner.
          allow update: if isOwner(uid) && request.resource.data == resource.data;
          allow delete: if false;
        }

        // streak_events — append-only per-event streak docs (W3.37).
        // Each streak event gets its own document keyed by a ULID.
        // Replaces the previous streak/data snapshot document.
        match /streak_events/{streakEventId} {
          // SR-4: cap list() at 500; single-doc get() is unrestricted.
          allow get: if isOwner(uid) || hasActiveTutorAccess(uid, profileId);
          allow list: if (isOwner(uid) || hasActiveTutorAccess(uid, profileId))
            && request.query.limit <= 500;
          // SR-3: created_at, when present, must be a server-bounded
          // Firestore Timestamp <= request.time — the same optional-field
          // guard as completions' completed_at above. The gateway
          // (FirestoreGatewayImpl._timestampifyField) converts the outbox's
          // ISO-8601 created_at string to a real Timestamp before this write
          // lands, so the comparison below is type-sound.
          allow create: if isOwner(uid)
            && (
              !('created_at' in request.resource.data)
                || (request.resource.data.created_at is timestamp
                    && request.resource.data.created_at <= request.time)
            );
          // SR-1 (append-only): update is allowed ONLY for the idempotent
          // merge:true re-push of the same ULID doc on outbox retry — the
          // new value must equal the existing value. A changed-value update
          // (tampering with an already-recorded streak event) is denied.
          allow update: if isOwner(uid) && request.resource.data == resource.data;
          allow delete: if false;
        }

        // learning_ledger — append-only daily ledger entries.
        // Doc-id: ULID from the payload (W3.36 — idempotent retries).
        match /learning_ledger/{entryId} {
          // SR-4: cap list() at 500; single-doc get() is unrestricted.
          allow get: if isOwner(uid) || hasActiveTutorAccess(uid, profileId);
          allow list: if (isOwner(uid) || hasActiveTutorAccess(uid, profileId))
            && request.query.limit <= 500;
          // ULID doc-id + set(merge:true): an outbox retry of an already-
          // committed entry is an UPDATE, so `update: false` would strand it
          // (permission-denied). Append-only is enforced by the
          // deterministic doc-id.
          // SR-3: completed_at, when present, must be a server-bounded
          // Firestore Timestamp <= request.time (same optional-field guard
          // as completions / streak_events above).
          allow create: if isOwner(uid)
            && (
              !('completed_at' in request.resource.data)
                || (request.resource.data.completed_at is timestamp
                    && request.resource.data.completed_at <= request.time)
            );
          // SR-1 (append-only): update is allowed ONLY for the idempotent
          // identical re-push, matching points_ledger below — a
          // changed-value update is denied.
          allow update: if isOwner(uid) && request.resource.data == resource.data;
          allow delete: if false;
        }

        // points_ledger — append-only points spend-economy ledger entries
        // (WS9 Wave-B / C#2). Doc-id: ULID from the payload (idempotent
        // retries); never deleted.
        match /points_ledger/{entryId} {
          // SR-4: cap list() at 500; single-doc get() is unrestricted.
          allow get: if isOwner(uid) || hasActiveTutorAccess(uid, profileId);
          allow list: if (isOwner(uid) || hasActiveTutorAccess(uid, profileId))
            && request.query.limit <= 500;
          // SR-3: created_at, when present, must be a server-bounded
          // Firestore Timestamp <= request.time (same optional-field guard
          // as completions / streak_events above).
          allow create: if isOwner(uid)
            && (
              !('created_at' in request.resource.data)
                || (request.resource.data.created_at is timestamp
                    && request.resource.data.created_at <= request.time)
            );
          // SR-1 (append-only): update is allowed ONLY for the idempotent
          // merge:true re-push of the same doc on outbox retry — a
          // changed-value update is denied.
          allow update: if isOwner(uid) && request.resource.data == resource.data;
          allow delete: if false;
        }

        // reward_redemptions — LWW redemption state-machine docs
        // (WS9 Wave-B / C#2). Doc-id: ULID from the payload. pending_fulfilment
        // → fulfilled / declined; the parent fulfils/declines so updates are
        // permitted. Never deleted.
        match /reward_redemptions/{redemptionId} {
          allow read: if isOwner(uid) || hasActiveTutorAccess(uid, profileId);
          allow create, update: if isOwner(uid);
          allow delete: if false;
        }

        // ── Snapshot collections ───────────────────────────────────────────
        // Hold current-state documents. Owner-gated reads/writes; deletes
        // denied except where the app explicitly removes an assignment.
        //
        // Collections with a stable, fully-enumerable payload gate create/
        // update through a `.hasOnly(...)` field whitelist. Preference-bag
        // collections carry a heterogeneous, open-ended payload — they are
        // owner-gated WITHOUT a whitelist to avoid dropping legitimate fields.
        //
        // `_`-prefixed bookkeeping keys are stripped by
        // `FirestoreGatewayImpl._stripInternalKeys` before any write, so
        // whitelists here are never tripped by internal keys.

        // settings — curriculum preference snapshots (open-ended bag).
        match /settings/{settingId} {
          allow read: if isOwner(uid) || hasActiveTutorAccess(uid, profileId);
          allow create, update: if isOwner(uid);
          allow delete: if false;
        }

        // stage_definitions — per-track stage configuration (W3.32 / closes T8).
        // Doc-id: "{trackId}_{stageOrder}". Stable, fully-enumerable payload.
        match /stage_definitions/{stageId} {
          allow read: if isOwner(uid) || hasActiveTutorAccess(uid, profileId);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'profile_id', 'curriculum_id', 'track_id', 'stage_order',
              'stage_name', 'schedule', 'delay_days', 'schedule_type',
              'is_default', 'days_of_week', 'rolling_window_size',
              'updated_at', 'synced_at'
            ]);
          allow delete: if false;
        }

        match /curriculum_tracks/{trackId} {
          allow read: if isOwner(uid) || hasActiveTutorAccess(uid, profileId);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'profile_id', 'track_id', 'curriculum_id', 'state',
              'state_changed_at', 'activated_at',
              'pace_reset_date', 'progress_schema_version',
              'progress_computed_at', 'progress_model', 'program_progress',
              'self_paced_progress', 'synced_at',
              // Track tombstone fields — a hard purge stamps `purged: true` +
              // `purged_at` so the deletion propagates to other devices
              // (track_dao.dart `track_purge:<id>` payload). Omitting these
              // from the allowlist denied every purge push with
              // permission-denied even for the legitimate owner.
              'purged', 'purged_at'
            ]);
          allow delete: if false;
        }

        match /bookmarks/{bookmarkId} {
          allow read: if isOwner(uid) || hasActiveTutorAccess(uid, profileId);
          // SR-2: hasOnly() only gates key sets — a compromised client could
          // still store an oversized/wrong-typed value under a whitelisted
          // key. sefaria_ref and curriculum_id are capped and type-checked
          // (when present) so a several-hundred-KB string can't ride in on
          // a legitimate field and drive the doc toward the 1 MiB ceiling.
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'profile_id', 'curriculum_id',
              'content_item_id', 'sefaria_ref', 'stage_id', 'updated_at',
              'synced_at'
            ])
            && (
              !('sefaria_ref' in request.resource.data)
                || (request.resource.data.sefaria_ref is string
                    && request.resource.data.sefaria_ref.size() <= 500)
            )
            && (
              !('curriculum_id' in request.resource.data)
                || (request.resource.data.curriculum_id is string
                    && request.resource.data.curriculum_id.size() <= 100)
            );
          allow delete: if false;
        }

        match /learning_order/{orderId} {
          allow read: if isOwner(uid) || hasActiveTutorAccess(uid, profileId);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'curriculum_id', 'sefaria_ref', 'ref', 'user_sort_order',
              'updated_at', 'synced_at'
            ]);
          allow delete: if false;
        }

        // preferences — unified preference bag (W3.33).
        // Scopes: notification_settings, gamification_settings, ui_preferences.
        // Open-ended payload — intentionally NOT whitelisted.
        match /preferences/{scope} {
          allow read: if isOwner(uid) || hasActiveTutorAccess(uid, profileId);
          // SR-2: this collection is intentionally NOT key-whitelisted (open,
          // heterogeneous payload across the notification_settings /
          // gamification_settings / ui_preferences scopes), so per-field
          // type/size checks aren't viable here the way they are on the
          // hasOnly()-guarded collections above — Firestore Rules has no
          // construct to iterate arbitrary map values generically. The
          // achievable SR-2 mitigation for a genuinely open bag is a
          // top-level key-count cap, guarding against a garbage/DoS payload
          // with an unbounded number of keys driving the doc toward the
          // 1 MiB ceiling; legitimate scopes carry well under 20 keys.
          allow create, update: if isOwner(uid)
            && request.resource.data.size() <= 50;
          allow delete: if false;
        }

        match /goals/{goalId} {
          allow read: if isOwner(uid) || hasActiveTutorAccess(uid, profileId);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'id', 'goal_id', 'profile_id', 'track_id', 'curriculum_id',
              'curriculumId', 'description', 'target_percent',
              'targetPercent', 'target_date', 'targetDate', 'date_type',
              'dateType', 'goal_type', 'goalType', 'pace_value', 'paceValue',
              'pace_unit', 'pacePeriod', 'paceGranularity', 'pace_granularity',
              'created_at',
              'createdAt', 'updated_at', 'updatedAt', 'synced_at'
            ]);
          // Owner delete permitted — unlike the append-only event
          // collections above, `create`/`update` are already owner-writable
          // here, so a client can already replace a goal's fields
          // arbitrarily; forbidding removal protected nothing. Matches the
          // sibling mutable-config collections below (`profile_programs`,
          // `curriculum_scopes`, `study_day_configs`), which all permit
          // owner delete. A tutor with `can_edit_goals` can already delete
          // a goal via the `tutorDeleteGoal` Cloud Function (Admin SDK,
          // bypasses these rules) — this closes the asymmetry where only
          // the tutor, not the owner, could remove the owner's own goal.
          allow delete: if isOwner(uid);
        }

        // import_metadata — curriculum import tracking (W3.34: renamed from
        // curriculum_import_metadata).
        match /import_metadata/{docId} {
          allow read: if isOwner(uid) || hasActiveTutorAccess(uid, profileId);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'profile_id', 'curriculum_id', 'item_count', 'imported_at',
              'synced_at'
            ]);
          allow delete: if false;
        }

        // profile_programs — curriculum assignments. Stable, fully-enumerable
        // payload. Client deletes are permitted for the owner so that
        // `removeProfileProgramAssignment` (track-removal / unenrolment) can
        // hard-delete the document. Without this, the delete call issued by
        // FirestoreGatewayImpl.removeProfileProgramAssignment receives
        // PERMISSION_DENIED and the deleted program resurfaces on next sync
        // (C4 fix — V3-W1).
        match /profile_programs/{curriculumId} {
          allow read: if isOwner(uid) || hasActiveTutorAccess(uid, profileId);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'profile_id', 'curriculum_id', 'program_id',
              'tracking_start_date', 'tracking_start_ref', 'synced_at',
              // `updated_at` is the LWW ordering field: the realtime listener
              // orders profile_programs by it (firestore_listener_source.dart)
              // and the merger uses it for last-write-wins. The client always
              // writes it, so omitting it from the allowlist denied every
              // enrolment push with permission-denied even for the owner.
              'updated_at'
            ]);
          allow delete: if isOwner(uid);
        }

        // curriculum_scopes — per-curriculum scope assignments.
        // Tutor-readable via S5 delta listener; client writes are owner-only.
        match /curriculum_scopes/{scopeId} {
          allow read: if isOwner(uid) || hasActiveTutorAccess(uid, profileId);
          allow create, update: if isOwner(uid);
          allow delete: if isOwner(uid);
        }

        // study_day_configs — per-curriculum, per-track day-of-week schedule
        // (Plan §F Phase 1 — closes the study-day sync gap). One doc per
        // (curriculum_id, day_of_week, track_id) triple; client-side LWW
        // arbitrated by `updated_at`.
        match /study_day_configs/{configId} {
          allow read: if isOwner(uid) || hasActiveTutorAccess(uid, profileId);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'profile_id', 'curriculum_id', 'track_id',
              'day_of_week', 'day_type', 'updated_at', 'synced_at'
            ]);
          allow delete: if isOwner(uid);
        }
      }
    }
  }
}
