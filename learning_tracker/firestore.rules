rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User-scoped data: only the authenticated user can access their own data
    match /users/{uid} {

      // Helper: request is from the document owner
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // Profile document
      match /profile {
        allow read, write: if isOwner();
      }

      // Completions subcollection (append-only log)
      match /completions/{completionId} {
        allow read: if isOwner();
        allow create: if isOwner();
        // Completions are immutable: no updates or deletes
        allow update, delete: if false;
      }

      // Bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner();
      }

      // Settings subcollection
      match /settings/{settingsId} {
        allow read, write: if isOwner();
      }

      // Streak document
      match /streak {
        allow read, write: if isOwner();
      }
    }
  }
}
