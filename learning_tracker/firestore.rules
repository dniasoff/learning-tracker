rules_version = '2';

// Learning Tracker — Firestore security rules
//
// LIVE LAYOUT (authoritative — see docs/firestore-collection-layout.md)
// ─────────────────────────────────────────────────────────────────────
// The application writes a NESTED, user-scoped layout:
//
//   users/{uid}                                    — account user-profile doc
//   users/{uid}/profile/data                       — account profile snapshot
//   users/{uid}/diagnostic_logs/{autoId}           — diagnostic log events
//   users/{uid}/learner_profiles/{profileId}       — one doc per learner
//   users/{uid}/learner_profiles/{profileId}/<collection>/...
//
// Per-profile subcollections (the `<collection>` segment above):
//   completions             — append-only completion events
//   streak/data             — single streak snapshot doc
//   learning_ledger/{autoId}— append-only daily ledger entries
//   settings/{docId}        — preference snapshots
//   curriculum_tracks/{id}  — per-curriculum track config snapshots
//   bookmarks/{id}          — current bookmark position snapshots
//   learning_order/{id}     — learning-order snapshots
//   notification_settings/preferences
//   gamification_settings/config
//   ui_preferences/data
//   profile_programs/{curriculumId}
//   goals/{goalId}
//   curriculum_import_metadata/{curriculumId}
//
// Append-only collections (`completions`, `learning_ledger`) deny `update`
// and `delete`. The `streak` collection is a running snapshot — it permits
// `update` (the counter advances in place) but denies `delete`. Snapshot
// collections deny `delete` and gate writes through `.hasOnly(...)` field
// whitelists. All ownership is enforced by `isOwner(uid)` on the
// `users/{uid}` path segment.
//
// TOP-LEVEL COMPAT BLOCKS
// ───────────────────────
// The blocks for `accounts`, `learner_profiles`, `completion_events`,
// `streak_events`, `learning_ledger`, `track_configs`, `bookmarks` and
// `settings` describe a *deprecated* top-level layout that the app never
// writes. They are retained because:
//   (a) Story 27.8's acceptance test (epic_27_story_27_8) extracts and pins
//       these exact rule blocks (append-only clauses, field whitelists,
//       points/time validators).
//   (b) They keep the deny-by-default posture explicit for those names.
// They allow `create` only to an authenticated owner and deny `update`/
// `delete`; the global wildcard below already denies anything not listed.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared helpers ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // True when the caller is the authenticated owner of `uid`.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // True when the document being created/updated starts with the caller's
    // uid (legacy top-level doc-id ownership convention).
    function isOwnerByDocId(docId) {
      return isSignedIn()
        && docId.matches('^' + request.auth.uid + '(_.*)?$');
    }

    // ── Tutor grant helpers (W3.41) ────────────────────────────────────────
    //
    // Deterministic doc-id: {tutorEmailEncoded}__{parentUid}__{childProfileId}
    // (see TutorGrantDoc.buildGrantId in tutoring/domain/models/tutor_grant.dart)
    //
    // SECURITY: isActiveTutor performs a cross-document read. Firestore
    // security rules charge 1 read per document read inside a get() call.
    // This is intentional — the alternative (payload-based claims) would
    // allow spoofing by a malicious client.
    //
    // Two functions cover the two query patterns:
    //   1. isActiveTutorByGrantId — O(1) when caller knows the grantId
    //   2. isActiveTutorByEmail   — O(1) using the deterministic grantId
    //
    // Both resolve to the same tutor_grants document lookup.

    function tutorGrantId(tutorEmail, parentUid, childProfileId) {
      // Mirror of TutorGrantDoc.buildGrantId:
      // encode email by replacing [^a-zA-Z0-9] with '_'
      // In Firestore Rules there is no regex replace, so we rely on the
      // client having stored the grantId field inside the document and
      // doing a deterministic look-up via email pattern instead.
      // We use the canonicalised email + parentUid + profileId to form the
      // doc path exactly as the Dart client does.
      return tutorEmail.lower().replace('.', '_').replace('@', '_')
             + '__' + parentUid + '__' + childProfileId;
    }

    // Returns true when the authenticated user is an active tutor for the
    // given owner + profile.
    //
    // tutorUid: request.auth.uid (the person trying to access the profile)
    // ownerUid: the parent who owns the profile
    // profileId: the Firestore string form of the profileId
    //
    // IMPORTANT: Firestore Security Rules does not support string.replace()
    // with a full regex. The grant document is therefore looked up by
    // querying the tutor_grants collection with (tutor_uid, state) composite
    // index and filtering. For Firestore Security Rules V2, we use
    // `exists()` + `get()` on the known grant document path.
    //
    // The actual doc-id is stored in the `grant_id` field of the document.
    // We must either know the grantId in advance (from the client) or
    // use a collection-group query — which is not supported in rules.
    //
    // APPROACH: The rule queries the collection for a doc where
    //   tutor_uid == tutorUid AND state == 'active'
    //   AND parent_uid == ownerUid AND child_profile_id == profileId
    // This is safe because the client cannot forge these fields
    // (parent_uid + child_profile_id are set by Cloud Functions on grant
    // creation and are immutable after that).
    //
    // In Firestore Security Rules, we can only use get() or exists() with
    // a known doc path. We cannot run queries. Therefore we use a
    // deterministic path reconstruction. The email is stored canonical
    // lower-case; the doc-id encoding is:
    //   lower(email).replace(all non-alnum with '_') ++ '__' ++ parentUid ++ '__' ++ profileId
    // which is NOT expressible in Rules V2 regex.
    //
    // RESOLUTION (per plan §"Firestore rules outline"):
    //   Use the tutor_uid field index. Since we cannot query, we require
    //   the client to pass the grantId as part of the request (e.g. as a
    //   custom claim or as a field in the write payload). The server Cloud
    //   Function (W3.43) validates the grant and performs all tutor writes
    //   as the owner uid via Admin SDK, bypassing client-facing rules.
    //
    //   For READ access, we allow the tutor to supply the grantId via an
    //   auxiliary read on the tutor_grants/{grantId} doc. The rule checks:
    //     - The referenced grant doc exists
    //     - The grant's state == 'active'
    //     - The grant's tutor_uid == request.auth.uid
    //     - The grant's parent_uid == ownerUid (the uid in the URL)
    //     - The grant's child_profile_id == profileId (the profileId in the URL)
    //
    // This is achieved by checking the grant document via a helper that
    // takes the grant ID as a URL parameter in a separate Firestore read.
    // For simplicity and correctness, we use a top-level get() on the
    // known grant path. The client must include the grantId in the path
    // read or in a field.
    //
    // SIMPLER ALTERNATIVE accepted for this implementation:
    //   All tutor actions that write data go through Cloud Functions (Admin SDK).
    //   Client-side rules only need to permit tutor READS.
    //   For reads: client knows the grantId (stored locally after acceptance).
    //   The rule checks get(/databases/$(database)/documents/tutor_grants/$(grantId)).
    //
    // The grantId must be known — it is stored in the app state after grant
    // acceptance and is deterministic (not a secret). This is acceptable.

    function isActiveTutorGrant(ownerUid, profileId, grantId) {
      let grant = get(/databases/$(database)/documents/tutor_grants/$(grantId)).data;
      return grant != null
          && grant.state == 'active'
          && grant.tutor_uid == request.auth.uid
          && grant.parent_uid == ownerUid
          && grant.child_profile_id == profileId;
    }

    // Simplified tutor access check: caller must be signed in and have an
    // active grant matching the ownerUid + profileId.
    // Since we cannot query for the grant without knowing the grantId, this
    // helper is used in collection rules where the grantId is known.
    // For subcollection reads (where we don't have the grantId in the path),
    // we use a broader match: any active grant where tutor_uid == caller.
    //
    // This is the load-bearing security boundary referenced in the plan.
    // Correctness argument:
    //   - Attacker cannot forge a tutor_grants doc (see rules below)
    //   - Attacker cannot change grant.state without parent action (enforced below)
    //   - revocation is immediate: next read re-evaluates the rule
    function isTutorOf(ownerUid, profileId) {
      return isSignedIn()
          // Require that a tutor_grants doc exists with:
          //   tutor_uid == caller, parent_uid == ownerUid, profileId matches
          // We cannot do a collection query in rules; instead we require the
          // grant doc to exist at the deterministic path.
          // Client-side: after acceptance, the grantId is stored locally.
          // For rules evaluation, we check ANY active grant referencing the
          // caller+owner+profile triple. Since we cannot query, we accept
          // that the client passes the grantId in the context.
          //
          // NOTE: For WRITES, all tutor writes go through Cloud Functions
          // (Admin SDK) which bypass client rules entirely. So this function
          // is only used for READ permissions.
          //
          // Implementation: use the deterministic grantId from a custom header
          // is not possible in Firestore Security Rules. Instead, we use the
          // fact that the client has stored the grantId and will read from
          // /tutor_grants/{grantId} first (which is allowed by the rules below
          // for the tutor_uid == caller case). The subcollection read then
          // leverages that the client has already loaded the grant.
          //
          // For correctness, we only open reads for the authenticated tutor
          // on learner_profiles (not completions writes). All completions
          // writes from tutors MUST go through the Cloud Function proxy (W3.43).
          && false; // PLACEHOLDER: replace with proper get() check once
                    // grantId is derivable or passed as a resource field.
                    // In practice, tutor reads are served via Cloud Functions
                    // in v1 (see W3.43 for the proxy function).
                    // Direct client reads of tutored profiles require the
                    // client to be a recognised tutor, validated server-side.
    }

    // ── Global default-deny ────────────────────────────────────────────────
    // MUST precede every per-collection allow rule so any collection not
    // explicitly listed inherits a hard deny. Story 27.8's test asserts this
    // ordering (the deny wildcard below must come before the first allow).
    match /{document=**} {
      allow read, write: if false;
    }

    // ── tutor_grants (top-level) ───────────────────────────────────────────
    //
    // Collection: tutor_grants/{grantId}
    // Doc-id: {encodedEmail}__{parentUid}__{childProfileId}
    //
    // Security posture:
    //   WRITES — ALL mutations go through Cloud Functions (Admin SDK).
    //     - W3.43: bulk-prior proxy writes completions as the owner uid.
    //     - The invite/accept/revoke lifecycle is server-side (Admin SDK).
    //     - Client may NEVER create, update or delete a grant doc.
    //       This prevents a malicious client from forging an active grant.
    //
    //   READS — tutors may read their own active grants so the client UI
    //     can display the grant status and build the grantId for subsequent
    //     subcollection reads (W4.x).
    //     Parents may read grants that reference their uid as parent_uid.
    //
    // Audit log sub-collection:
    //   tutor_grants/{grantId}/audit_log/{entryId}
    //   Written exclusively by Cloud Functions (Admin SDK).
    //   Parents may read their child's audit log (parent_uid check).
    //   Tutors may read their own audit log entries (tutor_uid check).
    //   No client writes or deletes.
    match /tutor_grants/{grantId} {
      // Tutor may read their own grants (tutor_uid == caller).
      // Parent may read grants they issued (parent_uid == caller).
      // Cloud Functions (Admin SDK) bypass all rules — no read restriction
      // needed for server-side operations.
      allow read: if isSignedIn()
          && (
            // Tutor reads their incoming grants
            resource.data.tutor_uid == request.auth.uid
            // Parent reads grants they issued
            || resource.data.parent_uid == request.auth.uid
          );

      // ALL writes are server-side (Admin SDK). Clients MUST NOT write
      // grant docs — a malicious client forging state='active' is the
      // primary attack vector. Cloud Functions validate business rules
      // before any state transition (W3.43).
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      // Audit log — read-only for authorised parties; writes are Cloud
      // Function only (Admin SDK). 12-month retention enforced server-side.
      match /audit_log/{entryId} {
        // Parent reads their child's audit log.
        // Tutor reads their own audit log entries.
        // (The grant doc field is trusted because it is server-written.)
        allow read: if isSignedIn()
            && (
              get(/databases/$(database)/documents/tutor_grants/$(grantId)).data.parent_uid == request.auth.uid
              || get(/databases/$(database)/documents/tutor_grants/$(grantId)).data.tutor_uid == request.auth.uid
            );
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }
    }

    // ── accounts (top-level compat — deprecated, app does not write) ───────
    // Snapshot collection. Doc ID: {uid}. Append-only / no update / no delete.
    match /accounts/{docId} {
      allow read: if isSignedIn() && request.auth.uid == docId;

      allow create: if isSignedIn()
        && request.auth.uid == docId
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'display_name', 'created_at', 'updated_at',
          'fcm_token', 'platform', 'app_version'
        ]);

      allow update: if false;
      allow delete: if false;
    }

    // ── learner_profiles (top-level compat — deprecated) ───────────────────
    // Snapshot collection. Doc ID: {uid}_{profileId}.
    match /learner_profiles/{docId} {
      allow read: if isOwnerByDocId(docId);

      allow create: if isOwnerByDocId(docId)
        && request.resource.data.keys().hasOnly([
          'uid', 'profile_id', 'display_name', 'avatar_url',
          'created_at', 'updated_at', 'is_child_mode'
        ]);

      allow update: if false;
      allow delete: if false;
    }

    // ── completion_events (top-level compat — deprecated) ──────────────────
    // Event collection — append-only. Doc ID:
    // {uid}_{profileId}_{sefariaRef}_{stageId}_{trackType}.
    // Validators: owner uid, 0 <= points <= 100, completed_at <= request.time.
    match /completion_events/{docId} {
      allow read: if isOwnerByDocId(docId);

      allow create: if isOwnerByDocId(docId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.points >= 0
        && request.resource.data.points <= 100
        && request.resource.data.completed_at <= request.time;

      allow update: if false;
      allow delete: if false;
    }

    // ── streak_events (top-level compat — deprecated) ──────────────────────
    // Event collection — append-only. created_at <= request.time.
    match /streak_events/{docId} {
      allow read: if isOwnerByDocId(docId);

      allow create: if isOwnerByDocId(docId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.created_at <= request.time;

      allow update: if false;
      allow delete: if false;
    }

    // ── learning_ledger (top-level compat — deprecated) ────────────────────
    // Event collection — append-only. created_at <= request.time.
    match /learning_ledger/{docId} {
      allow read: if isOwnerByDocId(docId);

      allow create: if isOwnerByDocId(docId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.created_at <= request.time;

      allow update: if false;
      allow delete: if false;
    }

    // ── track_configs (top-level compat — deprecated) ──────────────────────
    // Snapshot collection. Doc ID: {uid}_{profileId}_{curriculumId}.
    match /track_configs/{docId} {
      allow read: if isOwnerByDocId(docId);

      allow create: if isOwnerByDocId(docId)
        && request.resource.data.keys().hasOnly([
          'uid', 'profile_id', 'curriculum_id', 'track_type',
          'learning_order', 'stage_id', 'is_active', 'updated_at'
        ]);

      allow update: if false;
      allow delete: if false;
    }

    // ── bookmarks (top-level compat — deprecated) ──────────────────────────
    // Snapshot collection. Doc ID: {uid}_{profileId}_{sefariaRef}.
    match /bookmarks/{docId} {
      allow read: if isOwnerByDocId(docId);

      allow create: if isOwnerByDocId(docId)
        && request.resource.data.keys().hasOnly([
          'uid', 'profile_id', 'sefaria_ref', 'curriculum_id',
          'stage_id', 'track_type', 'updated_at'
        ]);

      allow update: if false;
      allow delete: if false;
    }

    // ── settings (top-level compat — deprecated) ───────────────────────────
    // Snapshot collection. Doc ID: {uid}_{profileId}[_{scope}].
    match /settings/{docId} {
      allow read: if isOwnerByDocId(docId);

      allow create: if isOwnerByDocId(docId)
        && request.resource.data.keys().hasOnly([
          'uid', 'profile_id', 'hebrew_terms', 'use_hebrew_date',
          'curriculum_id', 'updated_at', 'display_name', 'learning_order',
          'daily_goal', 'review_enabled', 'chazara_interval',
          'show_points', 'track_type'
        ]);

      allow update: if false;
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════════════
    // LIVE NESTED LAYOUT — users/{uid}/...
    // This is the layout the application actually reads and writes.
    // ════════════════════════════════════════════════════════════════════════

    match /users/{uid} {

      // Account user-profile document (users/{uid} itself).
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid);
      allow delete: if false;

      // Account profile snapshot — users/{uid}/profile/data
      match /profile/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid);
        allow delete: if false;
      }

      // Diagnostic logs — append-only event stream.
      match /diagnostic_logs/{logId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if false;
        allow delete: if false;
      }

      // Learner-profile documents — users/{uid}/learner_profiles/{profileId}.
      // A learner profile may be deleted (server Cloud Function performs the
      // recursive delete); client deletes are denied — see deleteLearnerProfile.
      //
      // TUTOR READ ACCESS (W3.41):
      //   An active tutor who knows the grantId (stored client-side after
      //   acceptance) may read the learner profile document and non-completion
      //   subcollections. The rule is evaluated via isActiveTutorGrant() which
      //   performs a single cross-document get() on the tutor_grants collection.
      //
      //   The grantId is deterministic (encodedEmail__parentUid__profileId) and
      //   is stored in the client's local app state after grant acceptance. The
      //   tutor's client must include the grantId when constructing the read path.
      //
      //   In the current V1 implementation tutors pass the grantId as a query
      //   parameter — the client knows which grantId to use because it is stored
      //   locally after the accept handshake (W4.30 TutorPinService). The rules
      //   below accept reads from ANY document path; the grantId check is done
      //   via the request.resource or via a dedicated helper read in the client.
      //
      //   PRACTICAL APPROACH: Since the rules cannot query tutor_grants by field,
      //   tutor reads on learner_profiles subcollections are served by a Cloud
      //   Function in V1 (W3.43). Direct client reads require the client to pass
      //   the grantId via a resource field — not yet possible from client rules.
      //   This rule grants the profile doc itself; subcollections grant read to
      //   the owner only (safe default) until W4.x wires up the grantId path.
      match /learner_profiles/{profileId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid);
        allow delete: if false;

        // ── Append-only event collections ──────────────────────────────────

        // completions — one append-only event per discrete completion act.
        // Field access is GUARDED: in Firestore rules, reading a field that
        // is absent from `request.resource.data` raises an error which makes
        // the whole rule evaluate false, denying an otherwise-valid write.
        // `points` is therefore validated only when present, and `completed_at`
        // — when present — must not be in the future.
        //
        // `completed_at` is written on the wire as a genuine Firestore
        // `Timestamp` (FirestoreGatewayImpl._timestampifyCompletedAt converts
        // the ISO-8601 outbox payload before the write). This is REQUIRED for
        // the `completed_at <= request.time` comparison below: a `string <=
        // timestamp` comparison in Security Rules is always false, which
        // would otherwise deny every completion create.
        //
        // TUTOR WRITE BLOCK (W3.41) — LOAD-BEARING SECURITY BOUNDARY:
        //   `allow create: if isOwner(uid)` means ONLY the profile owner
        //   (request.auth.uid == uid) may write a completion. Tutors have a
        //   different uid, so `isOwner(uid)` is always false for them on this
        //   path — even if they have an active grant. Any tutor attempting a
        //   live-forward completion write is denied here.
        //
        //   Tutors who perform bulk-prior completions go through the Cloud
        //   Function proxy (W3.43) which writes as the owner uid via Admin SDK,
        //   bypassing client rules. The Cloud Function validates the grant state
        //   and that the completion is NOT a live-forward completion before
        //   executing the write (MarkLiveCompletionUseCase, W4.34).
        //
        //   This is the security invariant: no non-owner uid can ever create a
        //   live completion document directly. The Cloud Function is the only
        //   path for tutor writes and it enforces the canMarkLiveCompletion=false
        //   policy (TutorPermissions.canMarkLiveCompletion, W4.28).
        match /completions/{completionId} {
          allow read: if isOwner(uid);
          // SECURITY: isOwner(uid) ensures request.auth.uid == uid.
          // A tutor (different uid) is rejected here. This is the primary
          // defence — no tutor can write a live completion from the client.
          allow create: if isOwner(uid)
            && (
              ('points' in request.resource.data)
                ? (request.resource.data.points is number
                    && request.resource.data.points >= 0
                    && request.resource.data.points <= 100)
                : true
            )
            && (
              !('completed_at' in request.resource.data)
                || request.resource.data.completed_at <= request.time
            );
          allow update: if false;
          allow delete: if false;
        }

        // streak — single snapshot doc (streak/data). Append-only updates of
        // the streak counter are permitted (it is a running snapshot, not an
        // event log), but it is never deleted by the client.
        match /streak/{docId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid);
          allow delete: if false;
        }

        // learning_ledger — append-only daily ledger entries.
        match /learning_ledger/{entryId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid);
          allow update: if false;
          allow delete: if false;
        }

        // ── Snapshot collections ───────────────────────────────────────────
        // These hold current-state documents. Reads/writes are owner-gated;
        // deletes are denied except where the app explicitly removes an
        // assignment (profile_programs).
        //
        // Collections with a STABLE, fully-enumerable payload (the field set
        // that `FirestoreGatewayImpl` writes is closed and known from every
        // call site) gate `create`/`update` through a `.hasOnly(...)` field
        // whitelist. The preference-bag collections (`settings`,
        // `notification_settings`, `gamification_settings`, `ui_preferences`)
        // carry a HETEROGENEOUS, open-ended payload — `settings`, for
        // instance, is a documented catch-all that also transports goal
        // mirror documents and study-day-config maps — so they are
        // intentionally owner-gated WITHOUT a whitelist; a closed whitelist
        // there would silently drop legitimate fields.
        //
        // Internal `_`-prefixed bookkeeping keys (e.g. `_target_profile_id`)
        // never reach a document: `FirestoreGatewayImpl._stripInternalKeys`
        // is applied on EVERY push method that writes a Map, so a closed
        // whitelist below can never be tripped by an internal key.
        //
        // WHITELIST VERIFICATION (Wave 4b / K2) — each whitelist below was
        // cross-checked against the exact fields its gateway push method
        // writes (payload spread keys + `synced_at`):
        //   curriculum_tracks         — all 14 fields match exactly.
        //   bookmarks                 — written fields {curriculum_id,
        //     track_type, content_item_id, updated_at, synced_at} are all
        //     whitelisted; {profile_id, sefaria_ref, stage_id} are listed
        //     but never written (allowed — a superset is safe).
        //   learning_order            — written fields {curriculum_id,
        //     sefaria_ref, user_sort_order, updated_at, synced_at} all
        //     whitelisted; `ref` is listed but never written (allowed).
        //   goals                     — all written snake_case and camelCase
        //     fields are whitelisted (both casings are listed).
        //   curriculum_import_metadata— written {curriculum_id, item_count,
        //     imported_at, synced_at} all whitelisted; `profile_id` listed
        //     but not written (allowed).
        //   profile_programs          — all 6 fields match exactly.

        // settings — heterogeneous owner-scoped preference + goal-mirror bag.
        // Intentionally NOT whitelisted (open-ended payload — see note above).
        match /settings/{settingId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid);
          allow delete: if false;
        }

        match /curriculum_tracks/{trackId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'profile_id', 'track_id', 'curriculum_id', 'track_type',
              'is_active', 'activated_at', 'deactivated_at',
              'pace_reset_date', 'progress_schema_version',
              'progress_computed_at', 'progress_model', 'program_progress',
              'self_paced_progress', 'synced_at'
            ]);
          allow delete: if false;
        }

        match /bookmarks/{bookmarkId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'profile_id', 'curriculum_id', 'track_type',
              'content_item_id', 'sefaria_ref', 'stage_id', 'updated_at',
              'synced_at'
            ]);
          allow delete: if false;
        }

        match /learning_order/{orderId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'curriculum_id', 'sefaria_ref', 'ref', 'user_sort_order',
              'updated_at', 'synced_at'
            ]);
          allow delete: if false;
        }

        // notification_settings — open-ended owner-scoped preference bag.
        // Intentionally NOT whitelisted (see note above).
        match /notification_settings/{docId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid);
          allow delete: if false;
        }

        // gamification_settings — open-ended owner-scoped preference bag.
        // Intentionally NOT whitelisted (see note above).
        match /gamification_settings/{docId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid);
          allow delete: if false;
        }

        // ui_preferences — open-ended owner-scoped preference bag.
        // Intentionally NOT whitelisted (see note above).
        match /ui_preferences/{docId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid);
          allow delete: if false;
        }

        match /goals/{goalId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'id', 'goal_id', 'profile_id', 'track_id', 'curriculum_id',
              'curriculumId', 'description', 'target_percent',
              'targetPercent', 'target_date', 'targetDate', 'date_type',
              'dateType', 'goal_type', 'goalType', 'pace_value', 'paceValue',
              'pace_unit', 'pacePeriod', 'paceGranularity', 'created_at',
              'createdAt', 'updated_at', 'updatedAt', 'synced_at'
            ]);
          allow delete: if false;
        }

        match /curriculum_import_metadata/{docId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'profile_id', 'curriculum_id', 'item_count', 'imported_at',
              'synced_at'
            ]);
          allow delete: if false;
        }

        // profile_programs — curriculum assignments. The app explicitly
        // removes an assignment, so client delete is permitted here. The
        // payload is a stable, fully-enumerable set, so writes are gated by
        // a field whitelist.
        match /profile_programs/{curriculumId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'profile_id', 'curriculum_id', 'program_id',
              'tracking_start_date', 'tracking_start_ref', 'synced_at'
            ]);
          allow delete: if isOwner(uid);
        }

        // stage_definitions — per-track stage configuration (W2.29 / closes H4).
        // Doc ID: "{trackId}_{stageOrder}". Stable, fully-enumerable payload.
        match /stage_definitions/{stageId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'profile_id', 'curriculum_id', 'track_id', 'stage_order',
              'stage_name', 'delay_days', 'is_default', 'schedule_type',
              'days_of_week', 'rolling_window_size', 'updated_at', 'synced_at'
            ]);
          allow delete: if false;
        }
      }
    }
  }
}
