rules_version = '2';

// Learning Tracker — Firestore security rules
//
// LIVE LAYOUT (authoritative — see docs/firestore-collection-layout.md)
// ─────────────────────────────────────────────────────────────────────
// The application writes a NESTED, user-scoped layout:
//
//   users/{uid}                                    — account user-profile doc
//   users/{uid}/profile/data                       — account profile snapshot
//   users/{uid}/diagnostic_logs/{autoId}           — diagnostic log events
//   users/{uid}/learner_profiles/{profileId}       — one doc per learner
//   users/{uid}/learner_profiles/{profileId}/<collection>/...
//
// Per-profile subcollections (the `<collection>` segment above):
//   completions             — append-only completion events
//   streak/data             — single streak snapshot doc
//   learning_ledger/{autoId}— append-only daily ledger entries
//   settings/{docId}        — preference snapshots
//   curriculum_tracks/{id}  — per-curriculum track config snapshots
//   bookmarks/{id}          — current bookmark position snapshots
//   learning_order/{id}     — learning-order snapshots
//   notification_settings/preferences
//   gamification_settings/config
//   ui_preferences/data
//   profile_programs/{curriculumId}
//   goals/{goalId}
//   curriculum_import_metadata/{curriculumId}
//
// Append-only collections (`completions`, `learning_ledger`) deny `update`
// and `delete`. The `streak` collection is a running snapshot — it permits
// `update` (the counter advances in place) but denies `delete`. Snapshot
// collections deny `delete` and gate writes through `.hasOnly(...)` field
// whitelists. All ownership is enforced by `isOwner(uid)` on the
// `users/{uid}` path segment.
//
// TOP-LEVEL COMPAT BLOCKS
// ───────────────────────
// The blocks for `accounts`, `learner_profiles`, `completion_events`,
// `streak_events`, `learning_ledger`, `track_configs`, `bookmarks` and
// `settings` describe a *deprecated* top-level layout that the app never
// writes. They are retained because:
//   (a) Story 27.8's acceptance test (epic_27_story_27_8) extracts and pins
//       these exact rule blocks (append-only clauses, field whitelists,
//       points/time validators).
//   (b) They keep the deny-by-default posture explicit for those names.
// They allow `create` only to an authenticated owner and deny `update`/
// `delete`; the global wildcard below already denies anything not listed.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared helpers ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // True when the caller is the authenticated owner of `uid`.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // True when the document being created/updated starts with the caller's
    // uid (legacy top-level doc-id ownership convention).
    function isOwnerByDocId(docId) {
      return isSignedIn()
        && docId.matches('^' + request.auth.uid + '(_.*)?$');
    }

    // ── Global default-deny ────────────────────────────────────────────────
    // MUST precede every per-collection allow rule so any collection not
    // explicitly listed inherits a hard deny. Story 27.8's test asserts this
    // ordering (the deny wildcard below must come before the first allow).
    match /{document=**} {
      allow read, write: if false;
    }

    // ── accounts (top-level compat — deprecated, app does not write) ───────
    // Snapshot collection. Doc ID: {uid}. Append-only / no update / no delete.
    match /accounts/{docId} {
      allow read: if isSignedIn() && request.auth.uid == docId;

      allow create: if isSignedIn()
        && request.auth.uid == docId
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'display_name', 'created_at', 'updated_at',
          'fcm_token', 'platform', 'app_version'
        ]);

      allow update: if false;
      allow delete: if false;
    }

    // ── learner_profiles (top-level compat — deprecated) ───────────────────
    // Snapshot collection. Doc ID: {uid}_{profileId}.
    match /learner_profiles/{docId} {
      allow read: if isOwnerByDocId(docId);

      allow create: if isOwnerByDocId(docId)
        && request.resource.data.keys().hasOnly([
          'uid', 'profile_id', 'display_name', 'avatar_url',
          'created_at', 'updated_at', 'is_child_mode'
        ]);

      allow update: if false;
      allow delete: if false;
    }

    // ── completion_events (top-level compat — deprecated) ──────────────────
    // Event collection — append-only. Doc ID:
    // {uid}_{profileId}_{sefariaRef}_{stageId}_{trackType}.
    // Validators: owner uid, 0 <= points <= 100, completed_at <= request.time.
    match /completion_events/{docId} {
      allow read: if isOwnerByDocId(docId);

      allow create: if isOwnerByDocId(docId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.points >= 0
        && request.resource.data.points <= 100
        && request.resource.data.completed_at <= request.time;

      allow update: if false;
      allow delete: if false;
    }

    // ── streak_events (top-level compat — deprecated) ──────────────────────
    // Event collection — append-only. created_at <= request.time.
    match /streak_events/{docId} {
      allow read: if isOwnerByDocId(docId);

      allow create: if isOwnerByDocId(docId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.created_at <= request.time;

      allow update: if false;
      allow delete: if false;
    }

    // ── learning_ledger (top-level compat — deprecated) ────────────────────
    // Event collection — append-only. created_at <= request.time.
    match /learning_ledger/{docId} {
      allow read: if isOwnerByDocId(docId);

      allow create: if isOwnerByDocId(docId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.created_at <= request.time;

      allow update: if false;
      allow delete: if false;
    }

    // ── track_configs (top-level compat — deprecated) ──────────────────────
    // Snapshot collection. Doc ID: {uid}_{profileId}_{curriculumId}.
    match /track_configs/{docId} {
      allow read: if isOwnerByDocId(docId);

      allow create: if isOwnerByDocId(docId)
        && request.resource.data.keys().hasOnly([
          'uid', 'profile_id', 'curriculum_id', 'track_type',
          'learning_order', 'stage_id', 'is_active', 'updated_at'
        ]);

      allow update: if false;
      allow delete: if false;
    }

    // ── bookmarks (top-level compat — deprecated) ──────────────────────────
    // Snapshot collection. Doc ID: {uid}_{profileId}_{sefariaRef}.
    match /bookmarks/{docId} {
      allow read: if isOwnerByDocId(docId);

      allow create: if isOwnerByDocId(docId)
        && request.resource.data.keys().hasOnly([
          'uid', 'profile_id', 'sefaria_ref', 'curriculum_id',
          'stage_id', 'track_type', 'updated_at'
        ]);

      allow update: if false;
      allow delete: if false;
    }

    // ── settings (top-level compat — deprecated) ───────────────────────────
    // Snapshot collection. Doc ID: {uid}_{profileId}[_{scope}].
    match /settings/{docId} {
      allow read: if isOwnerByDocId(docId);

      allow create: if isOwnerByDocId(docId)
        && request.resource.data.keys().hasOnly([
          'uid', 'profile_id', 'hebrew_terms', 'use_hebrew_date',
          'curriculum_id', 'updated_at', 'display_name', 'learning_order',
          'daily_goal', 'review_enabled', 'chazara_interval',
          'show_points', 'track_type'
        ]);

      allow update: if false;
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════════════
    // LIVE NESTED LAYOUT — users/{uid}/...
    // This is the layout the application actually reads and writes.
    // ════════════════════════════════════════════════════════════════════════

    match /users/{uid} {

      // Account user-profile document (users/{uid} itself).
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid);
      allow delete: if false;

      // Account profile snapshot — users/{uid}/profile/data
      match /profile/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid);
        allow delete: if false;
      }

      // Diagnostic logs — append-only event stream.
      match /diagnostic_logs/{logId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if false;
        allow delete: if false;
      }

      // Learner-profile documents — users/{uid}/learner_profiles/{profileId}.
      // A learner profile may be deleted (server Cloud Function performs the
      // recursive delete); client deletes are denied — see deleteLearnerProfile.
      match /learner_profiles/{profileId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid);
        allow delete: if false;

        // ── Append-only event collections ──────────────────────────────────

        // completions — one append-only event per discrete completion act.
        // Field access is GUARDED: in Firestore rules, reading a field that
        // is absent from `request.resource.data` raises an error which makes
        // the whole rule evaluate false, denying an otherwise-valid write.
        // `points` is therefore validated only when present, and `completed_at`
        // — when present — must not be in the future.
        match /completions/{completionId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && (
              ('points' in request.resource.data)
                ? (request.resource.data.points is number
                    && request.resource.data.points >= 0
                    && request.resource.data.points <= 100)
                : true
            )
            && (
              !('completed_at' in request.resource.data)
                || request.resource.data.completed_at <= request.time
            );
          allow update: if false;
          allow delete: if false;
        }

        // streak — single snapshot doc (streak/data). Append-only updates of
        // the streak counter are permitted (it is a running snapshot, not an
        // event log), but it is never deleted by the client.
        match /streak/{docId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid);
          allow delete: if false;
        }

        // learning_ledger — append-only daily ledger entries.
        match /learning_ledger/{entryId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid);
          allow update: if false;
          allow delete: if false;
        }

        // ── Snapshot collections ───────────────────────────────────────────
        // These hold current-state documents. Reads/writes are owner-gated;
        // deletes are denied except where the app explicitly removes an
        // assignment (profile_programs).
        //
        // Collections with a STABLE, fully-enumerable payload (the field set
        // that `FirestoreGatewayImpl` writes is closed and known from every
        // call site) gate `create`/`update` through a `.hasOnly(...)` field
        // whitelist. The preference-bag collections (`settings`,
        // `notification_settings`, `gamification_settings`, `ui_preferences`)
        // carry a HETEROGENEOUS, open-ended payload — `settings`, for
        // instance, is a documented catch-all that also transports goal
        // mirror documents and study-day-config maps — so they are
        // intentionally owner-gated WITHOUT a whitelist; a closed whitelist
        // there would silently drop legitimate fields. The `_target_profile_id`
        // bookkeeping key is stripped by the offline queue before any write,
        // so it never appears in `request.resource.data`.

        // settings — heterogeneous owner-scoped preference + goal-mirror bag.
        // Intentionally NOT whitelisted (open-ended payload — see note above).
        match /settings/{settingId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid);
          allow delete: if false;
        }

        match /curriculum_tracks/{trackId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'profile_id', 'track_id', 'curriculum_id', 'track_type',
              'is_active', 'activated_at', 'deactivated_at',
              'pace_reset_date', 'progress_schema_version',
              'progress_computed_at', 'progress_model', 'program_progress',
              'self_paced_progress', 'synced_at'
            ]);
          allow delete: if false;
        }

        match /bookmarks/{bookmarkId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'profile_id', 'curriculum_id', 'track_type',
              'content_item_id', 'sefaria_ref', 'stage_id', 'updated_at',
              'synced_at'
            ]);
          allow delete: if false;
        }

        match /learning_order/{orderId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'curriculum_id', 'sefaria_ref', 'ref', 'user_sort_order',
              'updated_at', 'synced_at'
            ]);
          allow delete: if false;
        }

        // notification_settings — open-ended owner-scoped preference bag.
        // Intentionally NOT whitelisted (see note above).
        match /notification_settings/{docId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid);
          allow delete: if false;
        }

        // gamification_settings — open-ended owner-scoped preference bag.
        // Intentionally NOT whitelisted (see note above).
        match /gamification_settings/{docId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid);
          allow delete: if false;
        }

        // ui_preferences — open-ended owner-scoped preference bag.
        // Intentionally NOT whitelisted (see note above).
        match /ui_preferences/{docId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid);
          allow delete: if false;
        }

        match /goals/{goalId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'id', 'goal_id', 'profile_id', 'track_id', 'curriculum_id',
              'curriculumId', 'description', 'target_percent',
              'targetPercent', 'target_date', 'targetDate', 'date_type',
              'dateType', 'goal_type', 'goalType', 'pace_value', 'paceValue',
              'pace_unit', 'pacePeriod', 'paceGranularity', 'created_at',
              'createdAt', 'updated_at', 'updatedAt', 'synced_at'
            ]);
          allow delete: if false;
        }

        match /curriculum_import_metadata/{docId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'profile_id', 'curriculum_id', 'item_count', 'imported_at',
              'synced_at'
            ]);
          allow delete: if false;
        }

        // profile_programs — curriculum assignments. The app explicitly
        // removes an assignment, so client delete is permitted here. The
        // payload is a stable, fully-enumerable set, so writes are gated by
        // a field whitelist.
        match /profile_programs/{curriculumId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'profile_id', 'curriculum_id', 'program_id',
              'tracking_start_date', 'tracking_start_ref', 'synced_at'
            ]);
          allow delete: if isOwner(uid);
        }
      }
    }
  }
}
