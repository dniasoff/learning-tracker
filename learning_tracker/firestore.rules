rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User-scoped data: only the authenticated user can access their own data
    match /users/{uid} {

      // Helper: request is from the document owner
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // Account-level profile document
      match /profile/{docId} {
        allow read, write: if isOwner();
      }

      // Profile-scoped data under users/{uid}/profiles/{profileId}/
      match /profiles/{profileId}/{document=**} {
        allow read, write: if isOwner();
      }
    }
  }
}
