{
  "enabledPlugins": {
    "bmad-docmost@bmad-modules": true,
    "bmad-flow@bmad-modules": true,
    "bmad-linear@bmad-modules": true,
    "flutter-mobile-design@ip-mobile-craft": true,
    "orvex-orchestrator@orvex-skills": true
  },
  "extraKnownMarketplaces": {
    "bmad-modules": {
      "source": {
        "repo": "orvexai/bmad-modules",
        "source": "github"
      }
    },
    "orvex-skills": {
      "source": {
        "repo": "orvexai/orvex-skills",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.bmad-loop/bmad_loop_hook.py PreCompact",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.bmad-loop/bmad_loop_hook.py SessionEnd",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.bmad-loop/bmad_loop_hook.py SessionStart",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.bmad-loop/bmad_loop_hook.py Stop",
            "type": "command"
          }
        ]
      }
    ]
  }
}
