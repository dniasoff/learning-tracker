rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{uid} {

      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      match /profile/{docId} {
        allow read, write: if isOwner();
      }

      // Account-level learner profile documents and all profile-scoped
      // subcollections live under learner_profiles.
      match /learner_profiles/{profileId} {
        allow read, write: if isOwner();
      }
      match /learner_profiles/{profileId}/{document=**} {
        allow read, write: if isOwner();
      }
    }
  }
}
