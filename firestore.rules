rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{uid} {
      // Account-level profile
      match /profile/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Account-level learner profile documents (one doc per learner/profile).
      match /learner_profiles/{profileId} {
        allow read, write: if isOwner(uid);
      }

      // Track-centric schema + profile-scoped state
      // ------------------------------------------------------------------
      // Canonical collections:
      // - completions/{completionId}
      // - learning_ledger/{entryId}
      // - tracks/{trackId}
      // - tracks/{trackId}/config/{scope|stage_plan|study_days|goal}
      // - bookmarks/{trackId}
      // - daily_plan/{yyyy-mm-dd}
      // - notification_settings/preferences
      // - gamification_settings/config
      // - projections/{active_curricula|streak|progress_summary}
      //
      // Existing collections kept for backward compatibility:
      // - settings/{curriculumId}
      // - goals/{goalId}
      // - active_curricula/data
      // - curriculum_tracks/{curriculumId_trackType}
      // - curriculum_imports/{curriculumId}
      // - streak/data
      // ------------------------------------------------------------------
      match /learner_profiles/{profileId}/{document=**} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
